  <style>
    .rule-highlight {
      animation: 
        ruleHighlightAnim 1s ease-in-out 0s 3,
        ruleFade 0.5s ease-in-out 3s 1;
      box-shadow: 0 0 0 4px rgba(255,224,0,0.5);
      background-color: transparent;
      border-radius: 4px;
    }
    @keyframes ruleHighlightAnim {
      0%   { background-color: transparent; }
      50%  { background-color: #ffe000; }
      100% { background-color: transparent; }
    }

    @keyframes ruleFade {
      0%   { box-shadow: 0 0 0 4px rgba(255,224,0,0.5); }
      100% { box-shadow: 0 0 0 4px rgba(255,224,0,0); }
    }
  </style>
    
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      try {
        const rawHash = window.location.hash;
        if (!rawHash) return;
    
        const id = rawHash.slice(1);
        if (!id) return;
    
        const target = document.getElementById(id);
        if (!target) {
          const alt = decodeURIComponent(id);
          if (alt !== id) {
            const altTarget = document.getElementById(alt);
            if (altTarget) {
              scrollAndHighlight(altTarget);
            }
          }
          return;
        }
    
        setTimeout(() => scrollAndHighlight(target), 50);
    
        function scrollAndHighlight(el) {
          el.scrollIntoView({ behavior: "smooth", block: "center" });
    
          el.classList.add("rule-highlight");
    
          setTimeout(() => el.classList.remove("rule-highlight"), 3500);
        }
      } catch (e) {
        console.error("terms hash handling error:", e);
      }
    });
  </script>
  
