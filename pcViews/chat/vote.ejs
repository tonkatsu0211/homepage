<button onclick="localStorage.setItem('voted', false);setCookie('voted', 'false', 7)">reset</button>

<div id="result"></div>

<script>
  function setCookie(name, value, days) {
    const expires = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toUTCString();
    document.cookie = name + '=' + encodeURIComponent(value) + '; expires=' + expires + '; path=/';
  }
  const rawDate = new Date().toLocaleString("ja-JP", { timeZone: "Asia/Tokyo" });
  const firstSpace = rawDate.indexOf(" ");
  let date;
  if (firstSpace !== -1) {
    date = rawDate.slice(0, firstSpace).trim();
  }
  const voteDates = ["2026/3/8", "2026/3/9", "2026/3/10", "2026/3/11", "2026/3/12", "2026/3/13", "2026/3/14", "2026/03/08", "2026/03/09"];

  const canVote = "<%= canVote %>";
  
  function vote(target) {
    const canVote2 = localStorage.getItem("voted") || false;
    alert(canVote);
    alert(canVote2);
    if (!voteDates.includes(date)) return alert("投票期間ではありません。");
    alert(canVote == "false" || canVote2 == "true");
    if (canVote == "false" || canVote2 == "true") return alert("投票権がありません。");
    const confirmed = confirm(`本当に${target}に投票しますか?`);
    if (!confirmed) return alert("投票をキャンセルしました。");

    const xhr = new XMLHttpRequest();
    xhr.open("POST", "/chat/vote", true);
    const resultDiv = document.getElementById("result");
    xhr.setRequestHeader("Content-Type", "application/x-www-form-urlencoded");
    xhr.onload = function() {
      if (xhr.status === 200) {
        const data = JSON.parse(xhr.responseText);
        if (data.error) {
          const msg = `投票処理中にエラーが発生しました: ${data.error}`;
          resultDiv.innerHTML = `<p style="color: red;">${msg}</p>`;
          alert(msg);
        } else {
          const msg = `${target} への投票が完了しました。`;
          resultDiv.innerHTML = `<p>${msg}</p>`;
          alert(msg);
          localStorage.setItem("voted", true);
        }
      } else {
        if (data.error) {
          const msg = `投票処理中にエラーが発生しました: ${data.error}</p>`;
          resultDiv.innerHTML = msg;
          alert(msg);
        } else {
          const msg = "<p style='color: red;'>投票処理中にエラーが発生しました。</p>";
          resultDiv.innerHTML = msg;
          alert(msg);
        }
      }
    };
    xhr.onerror = function() {
        alert("投票処理に失敗しました。");
    };
    xhr.send("target=" + encodeURIComponent(target));
  };
</script>

