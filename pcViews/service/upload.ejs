	document.getElementById("image-upload-form").addEventListener("submit", function(e) {
		e.preventDefault();
		const fileInput = document.getElementById("image-input");
		const filenameInput = document.getElementById("filename");
		if (!fileInput.files[0]) {
			alert("画像または動画を選択してください。");
			return;
		}
		const filename = filenameInput.value.trim();
		const invalidPattern = /[\\\/:*?"'<>|]/;
		if (invalidPattern.test(filename)) {
			alert("ファイル名に使用できない文字が含まれています。");
			return;
		}
		const formData = new FormData();
		formData.append("filename", filename);
		formData.append("image", fileInput.files[0]);
		const xhr = new XMLHttpRequest();
		xhr.open("POST", "/uploads", true);
		const progressBar = document.getElementById("upload-progress");
		const bar = document.getElementById("upload-bar");
		const percentText = document.getElementById("upload-percent");
		const resultDiv = document.getElementById("upload-result");
		xhr.upload.onprogress = function(event) {
			if (event.lengthComputable) {
				const percent = Math.round((event.loaded / event.total) * 100);
				progressBar.style.display = "block";
				bar.style.width = percent + "%";
				percentText.textContent = "アップロード中…　現在" + percent + "%";
			}
		};
		xhr.onload = function() {
			progressBar.style.display = "none";
			bar.style.width = "0%";
			percentText.textContent = "";
			if (xhr.status === 200) {
				const data = JSON.parse(xhr.responseText);
				if (data.error) {
					resultDiv.innerHTML = `<p style="color:red;">${data.error}</p>`;
				} else {
					const url = `${location.origin}${data.url}`;
          const fileType = fileInput.files[0].type;

          let previewTag = "";

          if (fileType.startsWith("video/")) {
            previewTag = `<video src="${data.url}" controls style="max-width:500px; display:block; margin-top:10px;"></video>`;
          } else if (fileType.startsWith("audio/")) {
            previewTag = `<audio src="${data.url}" controls style="max-width:500px; display:block; margin-top:10px;"></audio>`;
          } else if (fileType.startsWith("image")) {
            previewTag = `<img src="${data.url}" alt="アップロードされたファイル" style="max-width:500px; display:block; margin-top:10px;">`;
          } else if (fileType == "application/pdf") {
            previewTag = `<p>PDFファイルのためプレビュー不可</p>`
          }

					resultDiv.innerHTML = `<p>アップロード成功！</p><p>画像URL: <a href="${url}" target="_blank">${url}</a></p>${previewTag}`;
				}
			} else {
				alert("アップロード中にエラーが発生しました。");
			}
		};
		xhr.onerror = function() {
			alert("アップロードに失敗しました。");
		};
		xhr.send(formData);
	});
</script>  

