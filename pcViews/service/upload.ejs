<%- include("../settings/header") %>
<%- include("../settings/nav") %>
<%- include("../settings/top") %>

<p>
  画像、動画、音声、PDFをアップロードして、他のWebサイトやチャット・メッセージサービスに使うことができます。
</p>

<form id="image-upload-form" enctype="multipart/form-data">
  <input type="file" name="image" id="image-input" accept="image/*, video/mp4, video/webm, video/mov, video/mkv, video/m4v, video/ogg, video/ogv, application/pdf, audio/mp3, audio/m4a, audio/wav" required>
  <h2>
    <input class="loginText" type="text" id="filename" name="filename" placeholder="ファイル名（拡張子不要、任意）">
  </h2>
  <button type="submit" class="blueButton30">アップロード</button>
</form>
<div id="upload-progress" style="width: 100%; background: #333; height: 6px; margin-top: 5px; display: none;">
  <div id="upload-bar" style="height: 100%; width: 0%; background: #4caf50;"></div>
</div>
<div id="upload-percent"></div>

<br>
<br>

<div id="upload-result">
  <% if (error) { %>
    <p style="color:red;"><%= error %></p>
  <% } %>

  <% if (url) { %>
    <p>アップロード成功！</p>
    <p>画像URL: <a href="<%= url %>" target="_blank"><%= url %></a></p>
    <img id="upload-preview" alt="アップロード画像" style="max-width:300px; display:block; margin-top:10px;">
  <% } %>
</div>

<script>
