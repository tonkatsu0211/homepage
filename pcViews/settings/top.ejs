<div class="main">
  <div class="a00">
    <h1><%= top %></h1>
    <button
      id="reloadButton"
      class="normalButton"
      onclick="
  const page = '<%= page %>';
  const em = '<%= em %>'
  document.getElementById('reloadButton').textContent = '再読み込み中...';
  fetch('/log', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ message: 'reload on /<%= page %> ... OK' })
  }).then(() => {
    location.href = '<%= em === `true` ? `/empass/${page}` : `/${page}` %>'
  });
"
    >
      ページを再読み込み
    </button>
  </div>

  <h1 id="chText" style="font-size: 30px; color: #ff0000 !important">
    ページに関するお知らせやメンテナンス、移転等の情報を<a
      href="https://padlet.com/tonkatsu0211/page_notice"
      style="color: #ff0000; border-bottom: 1px solid #ff0000"
      >このページ</a
    >に掲載しています。必ずブックマークに登録し、エラーなどが発生した際はこのページを確認してください。
  </h1>

