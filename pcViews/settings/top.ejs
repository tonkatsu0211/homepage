    <h1><%= top %></h1>
    <button
      id="reloadButton"
      class="normalButton"
      onclick="
  const page = '<%= page %>';
  const em = '<%= em %>'
  document.getElementById('reloadButton').textContent = '再読み込み中...';
  fetch('/log', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ message: 'reload on /<%= page %> ... OK' })
  }).then(() => {
    location.href = '<%= em === `true` ? `/empass/${page}` : `/${page}` %>'
  });
"
    >
      ページを再読み込み
